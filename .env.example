# Copy file này thành .env.local để chạy `vercel dev`,
# và khai báo đúng 4 biến này trong Vercel → Settings → Environment Variables.
#
# KHÔNG điền giá trị thật vào file này — nó được commit lên GitHub.
# Giá trị thật chỉ nằm ở .env.local (đã .gitignore) và ở Vercel.

# Tài khoản (so sánh không phân biệt hoa thường)
AUTH_USER=

# Mật khẩu
AUTH_PASS=

# Chuỗi bí mật để ký cookie phiên. Tạo mới bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Nội dung ẩn hiện ra sau khi đăng nhập
SECRET_MESSAGE=

# --- Database lưu phím đã gắn keycap (tuỳ chọn nhưng NÊN có khi deploy) ---
# Vercel → Storage → Upstash Redis (hoặc Vercel KV). Sau khi kết nối, Vercel tự
# thêm hai biến này vào project; copy sang .env.local nếu muốn test ở máy.
# Không có hai biến này thì dữ liệu chỉ ghi ra file tạm + log, KHÔNG bền.
KV_REST_API_URL=
KV_REST_API_TOKEN=
